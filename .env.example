GROQ_API_KEY=your_groq_api_key_here

# REQUIRED. No fallback secret exists (CRITICAL-2 fixed in Phase 3). The server
# refuses to start if this is missing or shorter than 16 characters. Generate a
# real value: `openssl rand -hex 32`
JWT_SECRET=

NODE_ENV=development

# === Admin Override Credentials ===
# OPTIONAL. When BOTH are set, POST /v3/auth/login accepts these as an
# environment-level admin login. If either is empty the override is disabled
# (CRITICAL-1 fixed in Phase 3: an empty login body can no longer match).
ADMIN_EMAIL=
ADMIN_PASS=

# === Database ===
# DB_DIALECT=sqlite (default) or postgres
DB_DIALECT=sqlite
# Required only when DB_DIALECT=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/pulsegrid_db

# === Email (optional) ===
# When neither SMTP_HOST nor SENDGRID_API_KEY is set, email is SIMULATED
# (logged to console) and sendEmail() still reports success.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# EMAIL_FROM="pulsegrid OS" <notify@pulsegrid.fm>

# === Phase 4CF Deployment Seams ===
# SQLite file for this dedicated label instance (defaults to the active
# profile's sqliteFile: 'pulsegrid_v5.sqlite'). Absolute paths recommended for
# services/systemd.
# DB_STORAGE=/var/lib/pulsegrid/label.sqlite
# Active Label Intelligence Profile: selects src/profile/labels/<slug>.js
# (case-insensitive; unknown slugs fall back to the 'pulsegrid' reference).
# LABEL_SLUG=pulsegrid
# ACTIVE_LABEL=pulsegrid

# === Monthly report auto-printing ===
# When 'true', generated PDFs are sent to the system printer via a shell
# command. See SECURITY_AUDIT.md HIGH-6 before enabling.
AUTO_PRINT=false

# === Phase 1 API Integration ===
# Set USE_REAL_DATA=true when credentials are configured
USE_REAL_DATA=false

# Spotify Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Instagram Credentials (https://developers.facebook.com/)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Ticketmaster Credentials (https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# === Phase 2 API Integration ===
# YouTube Credentials (https://console.cloud.google.com/)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# === Phase 3 API Integration ===
# Twitter Credentials (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# TikTok Credentials (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# === Entity Audit Module ===
GOOGLE_KG_API_KEY=your_google_kg_api_key_here
DISCOGS_API_KEY=your_discogs_api_key_here
DISCOGS_API_SECRET=your_discogs_api_secret_here
GENIUS_API_TOKEN=your_genius_api_token_here

WIKIPEDIA_CLIENT_ID=your_wikipedia_client_id_here
WIKIPEDIA_CLIENT_SECRET=your_wikipedia_client_secret_here
WIKIPEDIA_ACCESS_TOKEN=your_wikipedia_access_token_here

# === Stripe Billing (TEST MODE ONLY) ===
# When STRIPE_SECRET_KEY is unset, the billing routes answer 503 and the rest
# of the app is unaffected. NEVER use a live key here: the server refuses any
# key that does not start with sk_test_. No real charges can be issued.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from the Stripe Dashboard (Developers -> Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_...
# One-time onboarding/setup fee Price (create as a one-time Price in Stripe).
# STRIPE_SETUP_PRICE_ID=price_...
# Recurring subscription Price. MONTHLY billing was chosen over yearly; the
# cadence is owned by this Price object — point it at a yearly Price to switch
# without a code change.
# STRIPE_SUBSCRIPTION_PRICE_ID=price_...
# Where Checkout redirects after success/cancel.
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
# TEST-ONLY: STRIPE_STUB=true swaps the real SDK for an in-memory stub so the
# regression suite never touches api.stripe.com. Never enable in production.
# STRIPE_STUB=
