{
  "name": "electronic-label-os",
  "version": "5.0.0",
  "description": "Concept Operating System for Electronic Music Labels (Fan Project)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test": "node --test --test-force-exit tests/regression/*.test.js",
    "test:units": "node --test --test-force-exit tests/regression/units.test.js",
    "test:routes": "node --test --test-force-exit tests/regression/routes.test.js",
    "test:services": "node --test --test-force-exit tests/regression/services.test.js",
    "test:snapshot": "node --test --test-force-exit tests/regression/snapshot.test.js",
    "verify": "node tests/support/verify_phase2.js",
    "verify:hermetic": "node scripts/run-verify-hermetic.js",
    "snapshot:baseline": "node tests/support/probe.js server.js tests/snapshots/phase2_baseline.json"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^168.0.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mathjs": "^15.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.17.2",
    "pdfkit-table": "^0.1.99",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "spotify-web-api-node": "^5.0.2",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}